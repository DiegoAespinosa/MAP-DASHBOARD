# ============================================================
# MAP-DASHBOARD - variables de entorno (plantilla)
# Copiar a .env y completar. .env NUNCA se sube al repositorio.
# ============================================================

# --- Fuentes MAP a reconocer (Fase 1) ---------------------------------
# Una por línea. El reconocimiento recorre MAP_URL_1..MAP_URL_50 sin huecos.
# Nombre opcional: MAP_URL_1_NAME=Indicadores SISMAP
MAP_URL_1=https://www.sismap.gob.do/GestionPublica/CargaEvidencia/Index/177?catchall=Instituto-Nacional-de-Aguas-Potables-y-Alcantarillados
MAP_URL_1_NAME="SISMAP"
MAP_URL_2=https://www.sismap.gob.do/GestionPublica/Ranking/InformeAnualEdiView
MAP_URL_2_NAME="Vista anual EDI"
MAP_URL_3=https://www.sismap.gob.do/GestionPublica/CargaEvidenciaEdi/Index/177?catchall=Instituto-Nacional-de-Aguas-Potables-y-Alcantarillados
MAP_URL_3_NAME="Implementacion EDI"
MAP_URL_4=https://www.sismap.gob.do/GestionPublica/CargaEvidencia/PoliticasTransversales/177?catchall=Instituto-Nacional-de-Aguas-Potables-y-Alcantarillados
MAP_URL_4_NAME="Politicas Transversales"


# --- Cuenta autorizada del MAP ---------------------------------------------
# Solo la usa el worker/reconocimiento. Nunca el frontend.
MAP_USERNAME=
MAP_PASSWORD=
# URL de login si es distinta de las fuentes (opcional)
MAP_LOGIN_URL=

# --- Opciones del reconocimiento -----------------------------------------
# true = intentar login automático con usuario/password (sin MFA/CAPTCHA).
# false = usar sesión guardada con `npm run recon:login` (login manual, recomendado).
MAP_RECON_AUTO_LOGIN=false
# false = ver el navegador durante el reconocimiento
MAP_RECON_HEADLESS=true
# Segundos que el reconocimiento espera para que el operador navegue manualmente
# (seleccionar período, abrir detalle, cambiar institución). 0 = desactivado.
MAP_RECON_INTERACTIVE_SECONDS=0
# Navegador: vacío = Chromium de Playwright; chrome | msedge = navegador del sistema
MAP_RECON_BROWSER_CHANNEL=
# Dónde se guarda el storageState de Playwright (fuera del repo por .gitignore)
MAP_STORAGE_STATE=./.secrets/map.storage-state.json

# --- Aplicación ---------------------------------------------------------
# PostgreSQL (en Docker Compose el host es "postgres")
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/map_dashboard
# Carpeta donde la app guarda la sesión de SISMAP y capturas de error (volumen en Docker)
APP_DATA_DIR=./data
# Hosts a los que la app puede conectarse (seguridad: las URL de las fuentes deben pertenecer a estos)
MAP_ALLOWED_HOSTS=www.sismap.gob.do

# --- Docker Compose (producción) --------------------------------------------
# Dominio o IP pública para Caddy (HTTPS automático con dominio)
DOMAIN=
# Contraseña de PostgreSQL dentro de Docker (no se expone a Internet)
POSTGRES_USER=map
POSTGRES_PASSWORD=
# Restringir acceso por IP (CIDRs separados por espacio). 0.0.0.0/0 = sin restricción
ADMIN_ALLOWED_CIDRS=0.0.0.0/0
# Días que se conservan las copias de seguridad
BACKUP_RETENTION_DAYS=30
# Fila a tomar en las páginas de ranking (todas las instituciones); expresión regular, sin distinguir mayúsculas
MAP_ORGANISM_MATCH=INAPA|Aguas Potables
